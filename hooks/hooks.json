{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/usage-pacer\" pretool",
            "timeout": 21600,
            "statusMessage": "usage-pacer: checking ceilings..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/usage-pacer\" prompt"
          }
        ]
      }
    ]
  }
}
